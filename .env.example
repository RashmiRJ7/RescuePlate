# Copy this file to .env (same folder) and fill in your own values.
# .env is git-ignored. Never commit real credentials.
# Real environment variables with the same names take precedence over this file.

# MySQL 8 connection (database name per README: food_rescue)
DB_URL=jdbc:mysql://localhost:3306/food_rescue?serverTimezone=UTC
DB_USERNAME=your_mysql_user
DB_PASSWORD=your_mysql_password

# Set a long, random value before using the one-time initial admin setup page.
ADMIN_SETUP_KEY=

# Optional
# SERVER_PORT=8080
# JPA_DDL_AUTO=update
