    {
      "name": "Donor",
      "item": [
        {
          "name": "1. Post Valid Donation (Expect 201 AVAILABLE)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"foodName\": \"Freshly Cooked Veg Biryani\",\n  \"category\": \"COOKED_MEAL\",\n  \"quantity\": 50,\n  \"description\": \"Packed in sanitized foil containers\",\n  \"pickupAddress\": \"Club Road, Belagavi\",\n  \"latitude\": 15.8500,\n  \"longitude\": 74.5000,\n  \"safeUntil\": \"2026-11-22T16:00:00Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/donations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "donations"]
            }
          }
        },
        {
          "name": "2. Post Invalid Donation (Past safeUntil, Expect 400)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"foodName\": \"Expired Curry\",\n  \"category\": \"COOKED_MEAL\",\n  \"quantity\": 20,\n  \"pickupAddress\": \"Club Road, Belagavi\",\n  \"latitude\": 15.8500,\n  \"longitude\": 74.5000,\n  \"safeUntil\": \"2020-01-01T00:00:00Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/donations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "donations"]
            }
          }
        },
        {
          "name": "3. Get My Donations",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/donations/mine",
              "host": ["{{baseUrl}}"],
              "path": ["api", "donations", "mine"]
            }
          }
        },
        {
          "name": "4. Get Donation By ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/donations/{{donationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "donations", "{{donationId}}"]
            }
          }
        },
        {
          "name": "5. Get Donation Status History",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/donations/{{donationId}}/history",
              "host": ["{{baseUrl}}"],
              "path": ["api", "donations", "{{donationId}}", "history"]
            }
          }
        },
        {
          "name": "6. Donor Access NGO Feed (Expect 403 Forbidden)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/donations/feed",
              "host": ["{{baseUrl}}"],
              "path": ["api", "donations", "feed"]
            }
          }
        }
      ]
    },
    {
      "name": "NGO",
      "item": [
        {
          "name": "1. View Urgency-Ranked Feed",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/donations/feed",
              "host": ["{{baseUrl}}"],
              "path": ["api", "donations", "feed"]
            }
          }
        },
        {
          "name": "2. View Feed with Filters (?category=COOKED_MEAL)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/donations/feed?category=COOKED_MEAL&minQuantity=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "donations", "feed"],
              "query": [
                { "key": "category", "value": "COOKED_MEAL" },
                { "key": "minQuantity", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "3. Claim Donation (NGO 1 - Expect 201 Created)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/donations/{{donationId}}/claim",
              "host": ["{{baseUrl}}"],
              "path": ["api", "donations", "{{donationId}}", "claim"]
            }
          }
        },
        {
          "name": "4. Concurrency Double Claim (NGO 2 - Expect 409 Conflict)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/donations/{{donationId}}/claim",
              "host": ["{{baseUrl}}"],
              "path": ["api", "donations", "{{donationId}}", "claim"]
            }
          }
        },
        {
          "name": "5. View My Claims",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/claims/mine",
              "host": ["{{baseUrl}}"],
              "path": ["api", "claims", "mine"]
            }
          }
        },
        {
          "name": "6. Deliver Before Pickup (Expect 400 Bad Request)",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/claims/{{claimId}}/deliver",
              "host": ["{{baseUrl}}"],
              "path": ["api", "claims", "{{claimId}}", "deliver"]
            }
          }
        },
        {
          "name": "7. Mark Claim Picked Up (Expect 200)",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/claims/{{claimId}}/pickup",
              "host": ["{{baseUrl}}"],
              "path": ["api", "claims", "{{claimId}}", "pickup"]
            }
          }
        },
        {
          "name": "8. Mark Claim Delivered (Expect 200)",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/claims/{{claimId}}/deliver",
              "host": ["{{baseUrl}}"],
              "path": ["api", "claims", "{{claimId}}", "deliver"]
            }
          }
        },
        {
          "name": "9. Cancel Claim (Expect 200)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Volunteer transport unavailable\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/claims/{{claimId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["api", "claims", "{{claimId}}", "cancel"]
            }
          }
        }
      ]
