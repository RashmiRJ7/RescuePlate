          "name": "1. Register Donor",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"City Grand Hotel\",\n  \"email\": \"grandhotel@example.com\",\n  \"password\": \"Password@123\",\n  \"role\": \"DONOR\",\n  \"phone\": \"9845012345\",\n  \"address\": \"MG Road, Belagavi\",\n  \"latitude\": 15.8520,\n  \"longitude\": 74.5020\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "register"]
